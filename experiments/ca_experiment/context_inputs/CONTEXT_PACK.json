   "scope": "B_PR22_HOLDOUT",
   "type": "RESEARCH",
   "state": "ACTIVE",
   "value": {
    "finding": "per-file git cat-file subprocess is the current bottleneck (~26ms/file on Windows; 2000 files ≈ 53s, linear)",
    "suggestion": "consider git cat-file --batch streaming (est. 53s -> 2-4s)"
   },
   "source": {
