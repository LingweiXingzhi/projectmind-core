1: """HTTP API for the continuity service; old extension APIs stay unchanged."""
2: from extensions.continuity.inspection import capture, inspect, read_evidence, remotes
3: from extensions.continuity.store import repository_store
4: from extensions.continuity.model import STATES, ready_missing, ai_context, render_resume, export_packet, fail
5: from extensions.worklog.store import repository_store as logs_store
6: 
7: EXTENSION = {'title': '协同交接', 'description': '保存接续点，让人或 AI 从中断位置继续工作。'}
8: 
9: 
10: def handle(context, method, data):
11:     store = repository_store(context.repo)
12:     action = data.get('action', 'list')
13:     if method == 'GET':
14:         if action == 'list':
15:             return {'records': store.listing(), 'states': STATES}
16:         if action == 'config':
17:             addresses = remotes(context.repo)
18:             snap = context.snapshot()
19:             return {'revision': snap['revision'], 'nodes': snap['nodes'], 'states': STATES,
20:                     'defaultSource': {'kind': 'git_remote', 'value': 'https://' + addresses[0]['address']} if addresses else {'kind': 'local_path', 'value': str(context.repo)},
21:                     'note': '本机接续记录与文件交换，不是在线聊天或身份认证。'}
22:         if action == 'logs':
23:             return {'entries': logs_store(context.repo).listing()}
24:         if action == 'get':
25:             r = store.get(data.get('id'))
26:             return {'record': r, 'missing': ready_missing(r)}
27:         if action == 'inspect':
28:             return inspect(context, store.get(data.get('id')))
29:         if action == 'evidence':
30:             return read_evidence(context, store.get(data.get('id')), data.get('path'))
31:         if action == 'history':
32:             return {'history': store.history(data.get('id'))}
33:         if action == 'export':
34:             r = store.get(data.get('id'))
35:             return {'packet': export_packet(r), 'markdown': render_resume(r), 'aiContext': ai_context(r),
36:                     'legacyHandoff': r['handoff']}
37:     if method == 'POST':
38:         if action == 'create':
39:             return {'record': store.create(data, capture(context, data))}
40:         if action == 'update':
41:             return {'record': store.update(data)}
42:         if action == 'refresh_checkpoint':
43:             # Re-capture is explicit, preserving previous revisions.
44:             return {'record': store.update(data, capture(context, data))}
45:         if action == 'event':
46:             return {'record': store.event(data)}
47:         if action == 'followup':
48:             previous = store.get(data.get('id'))
49:             if data.get('expectedVersion') != previous['version']:
50:                 fail('原记录已变化，请重新打开后创建下一次接续点', 409)
51:             payload = {**data, 'task': data.get('task', previous['task']),
52:                        'checklist': [{'id': c['id'], 'text': c['text'], 'state': 'pending', 'note': '', 'evidence': ''} for c in previous['checklist']],
53:                        'scope': previous['scope'], 'logIds': data.get('logIds', []), 'sourceLocator': previous['handoff']['sourceLocator']}
54:             return {'record': store.create(payload, capture(context, payload), parent=previous['id'])}
55:         if action == 'import_start':
56:             return store.begin_import(data)
57:         if action == 'import_chunk':
58:             return store.import_chunk(data)
59:         if action == 'import_finish':
60:             return {'record': store.finish_import(data.get('uploadId'))}
61:         if action == 'import_cancel':
62:             return store.cancel_import(data.get('uploadId'))
63:         if action == 'import_packet':
64:             return {'record': store.import_record(data.get('packet'))}
65:     fail('不支持的接续操作')

