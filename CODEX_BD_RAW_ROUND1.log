356:             length = int(self.headers.get("Content-Length", "0"))
357:             if length < 1 or length > max_bytes:
358:                 raise ValueError("Invalid request size")
359:             request = json.loads(self.rfile.read(length))
360:             if not isinstance(request, dict):
