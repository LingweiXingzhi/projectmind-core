19: let snapshot, output, generation=0;
20: const el=id=>document.getElementById(id);
21: function clear(){generation++;el('summary').hidden=true;output=null;el('json').disabled=el('md').disabled=el('copy').disabled=true;el('preview').textContent='尚无有效交接包。';}
22: async function request(url, options){const r=await fetch(url,options);const data=await r.json();if(!r.ok)throw Error(data.error||'读取失败');return data;}
23: async function refresh(){snapshot=await request('/api/snapshot');el('version').textContent='代码：'+snapshot.revision+' · 地图核查：UNKNOWN';el('generate').disabled=el('main').disabled=false;const config=await request('/api/extensions/handoff');el('mainInfo').textContent=config.mainNote+(config.mainRevision?' 当前：'+config.mainRevision:' '+config.mainError);}
24: ['kind','source','base','ai','completed','pending','blockers','nextSteps'].forEach(id=>el(id).addEventListener('input',clear));
25: async function generate(mode){clear();const ticket=generation;el('message').textContent='';el('generate').disabled=el('main').disabled=true;try{const data={expectedRevision:snapshot.revision,sourceLocator:{kind:el('kind').value,value:el('source').value.trim()}};if(mode==='main')data.comparisonMode='main';else if(el('base').value.trim())data.baseRevision=el('base').value.trim();const notes={};['completed','pending','blockers','nextSteps'].forEach(id=>{if(el(id).value.trim())notes[id]=el(id).value.trim();});if(Object.keys(notes).length)data.workNotes=notes;if(el('ai').value.trim())data.aiCandidates=JSON.parse(el('ai').value);const response=await request('/api/extensions/handoff',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(ticket!==generation)return;output=response;const h=output.handoff;el('summary').hidden=false;el('counts').textContent='功能节点 '+h.nodes.length+' · '+('baseRevision' in h?'变化文件 '+h.changes.length:'未比较')+' · AI 候选 '+h.aiCandidates.length;el('review').textContent='优先复核：'+(h.reviewCandidates.map(r=>{const n=h.nodes.find(n=>n.id===r.nodeId);return n.title+'（'+r.changedEvidencePaths.join('、')+'）';}).join('；')||('baseRevision' in h?'没有地图证据匹配；仍需检查变化文件和地图覆盖范围。':'未比较，尚无复核项。'));el('unmapped').replaceChildren();if(h.unmappedChanges&&h.unmappedChanges.length){const label=document.createElement('p');label.textContent='地图未覆盖的变化（'+h.unmappedChanges.length+' 个）：需检查职责、调用方及地图覆盖范围。';const list=document.createElement('ul');h.unmappedChanges.forEach(change=>{const item=document.createElement('li');item.textContent=change.code+' · '+(change.oldPath?change.oldPath+' → ':'')+change.path;list.appendChild(item);});el('unmapped').append(label,list);}el('preview').textContent=output.markdown;el('json').disabled=el('md').disabled=el('copy').disabled=false;}catch(e){if(ticket!==generation)return;el('message').textContent=e.message;try{await refresh();}catch(err){el('message').textContent+='；'+err.message;}}finally{el('generate').disabled=el('main').disabled=!snapshot;}}
