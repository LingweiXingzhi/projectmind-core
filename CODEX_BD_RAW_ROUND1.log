61: def workspace(repo, include_diff=False):
62:     parts = git(repo, 'status', '--porcelain=v1', '-z', '--untracked-files=normal').split(b'\0')
63:     files = []
64:     i = 0
65:     while i < len(parts):
66:         item = parts[i]
67:         i += 1
68:         if not item:
69:             continue
70:         status = item[:2].decode(errors='replace')
71:         filename = item[3:].decode(errors='replace')
72:         value = {'status': status, 'path': filename}
73:         if 'R' in status or 'C' in status:
74:             if i < len(parts):
75:                 value['oldPath'] = parts[i].decode(errors='replace')
76:                 i += 1
77:         files.append(value)
78:     if len(files) > 2000:
79:         fail('工作区变化超过 2000 项，请缩小工作范围后保存')
80:     diff = ''
81:     truncated = False
82:     if include_diff:
83:         raw = git(repo, 'diff', '--no-ext-diff', '--no-textconv', '--binary', 'HEAD', '--').decode(errors='replace')
84:         truncated = len(raw) > 12000
85:         diff = raw[:12000]
86:     return {'files': files, 'diff': diff, 'diffIncluded': bool(include_diff), 'truncated': truncated,
87:             'note': '文件清单来自保存时工作区。未跟踪文件只列路径，原件不在包内；未提交差异不属于代码提交证据，JSON 不是可直接恢复的补丁。'}
