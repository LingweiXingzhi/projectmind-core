50: def remotes(repo):
51:     names = git(repo, 'remote').decode(errors='replace').splitlines()
52:     result = []
53:     for name in names:
54:         for value in git(repo, 'remote', 'get-url', '--all', name).decode(errors='replace').splitlines():
55:             canonical = canonical_remote(value)
56:             if canonical:
57:                 result.append({'name': name, 'address': canonical})
58:     return result
