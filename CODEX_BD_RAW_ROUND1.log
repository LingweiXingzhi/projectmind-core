126:     w = workspace(context.repo, data.get('includeWorktreeDiff', False))
127:     if context.snapshot()['revision'] != h['codeRevision'] or map_before != context.map_path.read_bytes():
128:         fail('读取期间代码或地图发生变化，请重新保存接续点', 409)
129:     return {'handoff': h, 'workspace': w, 'logs': logs,
130:             'mapCapture': {'digest': 'sha256:' + hashlib.sha256(map_before).hexdigest(), 'confirmedForRevision': None}}
