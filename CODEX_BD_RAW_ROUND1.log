1: """Extract definitions from committed blobs without running project code."""
2: from __future__ import annotations
3: 
4: import ast
5: import io
6: import os
7: import re
8: import subprocess
9: import tokenize
10: from pathlib import Path
11: 
12: MAX_FILES = 2000
13: MAX_FILE_BYTES = 1_048_576
14: MAX_TOTAL_BYTES = 16_777_216
15: SHA_PATTERN = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})\Z")
16: 
17: 
18: class CodeFactsError(ValueError):
19:     """Expected input or repository error, safe to show to a local user."""
20: 
21: 
22: def _git(repo: Path, *args: str) -> bytes:
23:     # Ignore inherited GIT_DIR/GIT_WORK_TREE and other overrides: repo is explicit.
24:     env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
25:     env.update({"GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0",
26:                 "GIT_NO_REPLACE_OBJECTS": "1", "GIT_NO_LAZY_FETCH": "1", "LC_ALL": "C"})
27:     try:
28:         result = subprocess.run(
29:             ["git", "--no-lazy-fetch", "--no-pager", "-C", str(repo), *args],
30:             stdin=subprocess.DEVNULL, capture_output=True, timeout=10, env=env,
31:         )
32:     except (OSError, subprocess.TimeoutExpired) as exc:
33:         raise CodeFactsError("Git 不可用或读取超时") from exc
34:     if result.returncode:
35:         if result.returncode == 129 and b"no-lazy-fetch" in result.stderr:
36:             raise CodeFactsError("Git 版本需支持 --no-lazy-fetch，请升级 Git 后重试")
37:         raise CodeFactsError("无法读取指定 Git 仓库、提交或对象")
38:     return result.stdout
39: 
40: 
41: def repository_root(repo: Path | str) -> Path:
42:     try:
43:         root = Path(repo).expanduser().resolve(strict=True)
44:     except (OSError, TypeError, ValueError) as exc:
45:         raise CodeFactsError("仓库路径无效") from exc
46:     if not root.is_dir():
47:         raise CodeFactsError("仓库路径必须是目录")
48:     actual = Path(os.fsdecode(_git(root, "rev-parse", "--show-toplevel").rstrip(b"\n"))).resolve()
49:     if actual != root:
50:         raise CodeFactsError("请提供 Git 仓库根目录，而非子目录")
51:     return root
52: 
53: 
54: def current_revision(repo: Path | str) -> str:
55:     """For initial UI defaults only; extraction still requires an explicit full SHA."""
56:     root = repository_root(repo)
57:     return _git(root, "rev-parse", "--verify", "HEAD^{commit}").decode("ascii").strip()
58: 
59: 
60: def _paths(paths: list[str] | None) -> list[str] | None:
61:     if paths is None:
62:         return None
63:     if not isinstance(paths, list) or len(paths) > MAX_FILES:
64:         raise CodeFactsError("paths 必须是最多 2000 项的路径列表")
65:     result = []
66:     for path in paths:
67:         if (
68:             not isinstance(path, str) or not path or "\\" in path
69:             or any(ord(char) < 32 or ord(char) == 127 for char in path)
70:             or any(part in ("", ".", "..") for part in path.split("/"))
71:         ):
72:             raise CodeFactsError("路径须为仓库内相对文件路径，使用 /，不能含 .. 或控制字符")
73:         if path not in result:
74:             result.append(path)
75:     return result
76: 
77: 
78: def _definitions(syntax: ast.AST) -> list[dict]:
79:     # An explicit stack also handles valid, deeply chained expressions without
80:     # exhausting Python's recursion limit in NodeVisitor.generic_visit.
81:     pending = [(syntax, ())]
82:     entries = []
83:     categories = {ast.ClassDef: "class", ast.FunctionDef: "function",
84:                   ast.AsyncFunctionDef: "async_function"}
85:     while pending:
86:         node, scope = pending.pop()
87:         category = categories.get(type(node))
88:         if category:
89:             kind = category
90:             if scope and scope[-1][1] == "class" and category != "class":
91:                 kind = "async_method" if category == "async_function" else "method"
92:             name = ".".join([part[0] for part in scope] + [node.name])
93:             entries.append({"name": name, "kind": kind, "line": node.lineno})
94:             scope = (*scope, (node.name, category))
95:         pending.extend((child, scope) for child in reversed(list(ast.iter_child_nodes(node))))
96:     return entries
97: 
98: 
99: def collect_code_facts(repo: Path | str, revision: str, paths: list[str] | None = None) -> dict:
100:     """Return {revision, files, skipped}; paths=None selects all committed files.
101: 
102:     Only def/async def/class declarations are facts. Qualified names describe
103:     lexical nesting, not call relationships, runtime reachability or responsibility.
104:     Invalid inputs reject the request; unsupported/unparseable files are skipped.
105:     """
106:     if not isinstance(revision, str) or not SHA_PATTERN.fullmatch(revision):
107:         raise CodeFactsError("revision 必须是完整的 40 或 64 位小写 Git 提交 SHA")
108:     requested = _paths(paths)
109:     root = repository_root(repo)
110:     resolved = _git(root, "rev-parse", "--verify", revision + "^{commit}").decode("ascii").strip()
111:     if resolved != revision:
112:         raise CodeFactsError("revision 必须直接指向提交，不能是标签对象")
113:     raw_tree = _git(root, "ls-tree", "-r", "-z", "--long", revision)
114:     tree = {}
115:     for record in raw_tree.split(b"\0"):
116:         if not record:
117:             continue
118:         metadata, raw_path = record.split(b"\t", 1)
119:         mode, object_type, oid, size = metadata.split()
120:         path = raw_path.decode("utf-8", errors="backslashreplace")
121:         tree[path] = (mode, object_type, oid, size, raw_path)
122:     if requested is not None:
123:         if any(path not in tree for path in requested):
124:             raise CodeFactsError("所选文件在指定提交中不存在；请核对提交和相对路径")
125:         selected = sorted(requested)
126:     else:
127:         selected = sorted(tree)
128:     if len(selected) > MAX_FILES:
129:         raise CodeFactsError("本次文件超过 2000 个，请通过 paths 缩小范围")
130:     files, skipped = [], []
131:     total_bytes = 0
132:     for path in selected:
133:         mode, object_type, oid, size, raw_path = tree[path]
134:         reason = None
135:         try:
136:             raw_path.decode("utf-8")
137:         except UnicodeError:
138:             reason = "文件名不是 UTF-8，首版不支持"
139:         if reason is None and (object_type != b"blob" or mode not in (b"100644", b"100755")):
140:             reason = "首版不读取符号链接或子模块"
141:         if reason is None and not path.endswith(".py"):
142:             reason = "首版仅支持 .py Python 文件"
143:         if reason is None and not size.isdigit():
144:             raise CodeFactsError("指定提交的对象在本地不可用，请先补全仓库；提取不会自动获取对象")
145:         if reason is None and int(size) > MAX_FILE_BYTES:
146:             reason = "文件超过首版 1 MiB 上限"
147:         if reason:
148:             skipped.append({"path": path, "reason": reason})
149:             continue
150:         total_bytes += int(size)
151:         if total_bytes > MAX_TOTAL_BYTES:
152:             raise CodeFactsError("本次 Python 内容超过 16 MiB，请缩小文件范围")
153:         raw = _git(root, "cat-file", "blob", oid.decode("ascii"))
154:         try:
155:             encoding, _ = tokenize.detect_encoding(io.BytesIO(raw).readline)
156:             source = raw.decode(encoding)
157:             syntax = ast.parse(source, filename=path)
158:         except (SyntaxError, UnicodeError, LookupError, ValueError, RecursionError):
159:             skipped.append({"path": path, "reason": "无法按当前 Python 解析器读取编码或语法"})
160:             continue
161:         files.append({"path": path, "language": "python", "entries": _definitions(syntax)})
162:     return {"revision": resolved, "files": files, "skipped": skipped}

