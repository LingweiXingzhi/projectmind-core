61: def load_map(map_path: Path) -> dict:
62:     with map_path.open(encoding="utf-8") as handle:
63:         curated = json.load(handle)
64:     if not isinstance(curated, dict) or not isinstance(curated.get("note"), str):
65:         raise ValueError("Map needs a note string")
66:     nodes = curated.get("nodes")
67:     edges = curated.get("edges")
68:     if not isinstance(nodes, list) or not nodes or not isinstance(edges, list):
69:         raise ValueError("Map needs a nonempty nodes list and an edges list")
70:     ids = set()
71:     for node in nodes:
72:         if not isinstance(node, dict) or any(not isinstance(node.get(key), str) or not node[key]
73:                                              for key in ("id", "title", "summary", "entryPoint")):
74:             raise ValueError("Each map node needs id, title, summary, and entryPoint strings")
75:         if node["id"] in ids:
76:             raise ValueError(f"Duplicate map node ID: {node['id']}")
77:         ids.add(node["id"])
78:         position = node.get("position")
79:         if not isinstance(position, dict) or any(
80:             isinstance(position.get(axis), bool) or not isinstance(position.get(axis), (int, float))
81:             or not math.isfinite(position[axis]) or position[axis] < 0 for axis in ("x", "y")
82:         ):
83:             raise ValueError(f"Map node {node['id']} needs nonnegative finite x/y positions")
84:         evidence = node.get("evidence")
85:         if not isinstance(evidence, list) or any(
86:             not isinstance(item, dict) or not isinstance(item.get("path"), str) or not item["path"]
87:             or not isinstance(item.get("reason"), str) for item in evidence
88:         ):
89:             raise ValueError(f"Map node {node['id']} needs an evidence list with path and reason")
90:     for edge in edges:
91:         if not isinstance(edge, dict) or not isinstance(edge.get("from"), str) or not isinstance(edge.get("to"), str) \
92:                 or edge["from"] not in ids or edge["to"] not in ids or not isinstance(edge.get("label"), str):
93:             raise ValueError("Each map edge needs known from/to node IDs and a label string")
94:     return curated
