459: def main() -> None:
460:     parser = argparse.ArgumentParser(description="Run the local ProjectMind map demo")
461:     parser.add_argument("--port", type=int, default=8765)
462:     parser.add_argument("--repo", type=Path, help="Local Git repository to inspect; defaults to this repository")
463:     parser.add_argument("--map", type=Path, help="Curated map JSON for the chosen repository")
464:     args = parser.parse_args()
