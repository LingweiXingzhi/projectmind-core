37: def git(repo: Path, *args: str) -> bytes:
38:     result = subprocess.run(
39:         ["git", "-C", str(repo), *args],
40:         stdout=subprocess.PIPE,
41:         stderr=subprocess.PIPE,
42:         check=False,
43:     )
44:     if result.returncode:
45:         message = result.stderr.decode("utf-8", errors="replace").strip()
46:         raise GitError(message or f"git {' '.join(args)} failed")
47:     return result.stdout
