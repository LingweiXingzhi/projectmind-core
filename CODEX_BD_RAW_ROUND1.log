133: def inspect(context, record):
134:     snapshot = context.snapshot()
135:     h = record['handoff']
136:     addresses = remotes(context.repo)
137:     source = h['sourceLocator']
138:     expected = canonical_remote(source['value']) if source['kind'] == 'git_remote' else None
139:     if source['kind'] == 'local_path':
140:         source_state = 'same_local_path' if source['value'] == str(context.repo) else 'unknown'
141:     elif expected and addresses:
142:         source_state = 'address_match' if any(e['address'] == expected for e in addresses) else 'address_mismatch'
143:     else:
144:         source_state = 'unknown'
145:     revision = h['codeRevision']
146:     try:
147:         exists = git(context.repo, 'rev-parse', '--verify', revision + '^{commit}').decode().strip() == revision
148:     except Exception as exc:
149:         from extension_host import ExtensionError
150:         if not isinstance(exc, ExtensionError):
151:             raise
152:         exists = False
153:     same = exists and snapshot['revision'] == revision
154:     comparison = None
155:     if exists and not same and source_state in ('address_match', 'same_local_path'):
156:         comparison = context.compare(revision, snapshot['revision'])
157:         # Compare once through the public Git API, match against the saved map.
158:         declared = {n['id']: set(n['evidencePaths']) for n in h['nodes']}
159:         changed = {p for c in comparison['changes'] for p in (c['path'], c.get('oldPath')) if p}
160:         comparison = {**comparison, 'reviewCandidates': [{'nodeId': k, 'changedEvidencePaths': sorted(v & changed)} for k, v in declared.items() if v & changed],
161:                       'note': '文件变化由 Git 提供，复核项按交接包保存的地图证据匹配；不证明功能影响。'}
162:     map_state = 'unknown'
163:     if record.get('mapCapture'):
164:         digest = 'sha256:' + hashlib.sha256(context.map_path.read_bytes()).hexdigest()
165:         map_state = 'same_bytes' if digest == record['mapCapture']['digest'] else 'changed'
166:     log_states = []
167:     if record['logs']:
168:         store = log_store(context.repo)
169:         for log in record['logs']:
170:             try:
171:                 current = store.get(log['id'])
172:                 state = 'same_version' if current['version'] == log['version'] and current['body'] == log['body'] and current['title'] == log['title'] else 'updated'
173:             except Exception as exc:
174:                 from extension_host import ExtensionError
175:                 if not isinstance(exc, ExtensionError):
176:                     raise
177:                 state = 'not_local'
178:             log_states.append({'id': log['id'], 'title': log['title'], 'state': state, 'savedVersion': log['version']})
179:     evidence = []
180:     if exists:
181:         tracked = set(p.decode(errors='replace') for p in git(context.repo, 'ls-tree', '-r', '--name-only', '-z', revision).split(b'\0') if p)
182:         evidence = [{'path': p, 'exists': p in tracked} for p in sorted({p for n in h['nodes'] for p in n['evidencePaths']})]
183:     return {'sourceState': source_state, 'sourceNote': '只比较来源地址；不是已验证的仓库身份。来源未知或不同，不自动比较两个项目。',
184:             'localAddresses': addresses, 'savedRevision': revision, 'currentRevision': snapshot['revision'],
185:             'commitAvailable': exists, 'revisionState': 'same' if same else ('different' if exists else 'missing'),
186:             'comparison': comparison, 'mapState': map_state, 'mapConfirmed': False,
187:             'workspace': workspace(context.repo), 'logs': log_states, 'evidence': evidence}
