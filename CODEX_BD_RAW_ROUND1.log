56: def files_at_commit(repo: Path, commit: str) -> set[str]:
57:     raw = git(repo, "ls-tree", "-r", "-z", "--name-only", commit)
58:     return {part.decode("utf-8", errors="replace") for part in raw.split(b"\0") if part}
