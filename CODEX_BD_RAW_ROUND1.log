247: def render_resume(record):
248:     t = lambda v: str(v).replace('<', '&lt;').replace('>', '&gt;')
249:     job = record['task']
250:     lines = ['# 工作接续 · ' + t(job['title']), '',
251:              '本记录是可核查的工作资料，不是执行授权或已确认架构。', '',
252:              '## 先从这里继续', '', '- 目标：' + t(job['goal'] or '未填写'),
253:              '- 停止位置：' + t(job['stopPoint'] or '未填写'),
254:              '- 第一项行动：' + t(job['nextAction'] or '未填写'),
255:              '- 已完成：' + t(job['completed'] or '未填写'),
256:              '- 运行方法（仅文本，不自动执行）：' + t(job['runInstructions'] or '未填写'),
257:              '- 完成标准：' + t(job['acceptance'] or '未填写'),
258:              '- 注意事项：' + t(job['cautions'] or '未填写'),
259:              '- 状态：' + STATES[record['state']] + '（参与者记录，不等于独立验收）',
260:              '- 接续记录版本：' + str(record['version']), '']
261:     if record.get('scope'):
262:         lines += ['## 优先阅读的功能范围', '']
263:         for n in record['handoff']['nodes']:
264:             if n['id'] in record['scope']:
265:                 lines.append('- ' + t(n['title']) + '：' + '、'.join(t(p) for p in n['evidencePaths']))
266:         lines += ['', '所选范围是阅读优先级，不证明其他功能不受影响；完整地图保留在后文。', '']
267:     if record['checklist']:
268:         lines += ['## 行动与验证清单', '']
269:         for c in record['checklist']:
270:             lines.append('- [' + ('x' if c['state'] == 'done' else ' ') + '] ' + t(c['text']) + ' · ' + c['state'] + ' · ' + t(c['note']) + ' · 依据：' + t(c['evidence']))
271:     workspace = record.get('workspace')
272:     if workspace:
273:         lines += ['', '## 保存时未提交的工作', '', t(workspace['note'])]
274:         lines.extend('- ' + t(f['status']) + ' · ' + t(f['path']) for f in workspace['files'])
275:         if workspace['diffIncluded']:
276:             lines += ['', '未提交文本差异（不属于提交证据，可能截断）：', '', t(workspace['diff'])]
277:     lines += ['', '## 选取的日志依据', '', '日志为固定版本快照，作者自行填写；不会自动成为团队正式决定。']
278:     if not record['logs']:
279:         lines += ['未选取日志；没有记录不代表没有发生。']
280:     for log in record['logs']:
281:         lines += ['', '### ' + t(log['title']), '- 分类：' + CATEGORIES[log['category']] + ' · 第 ' + str(log['version']) + ' 版 · ' + log['status'],
282:                   '- 保存时提交：' + t(log['codeRevision']), '', t(log['body'])]
283:         if log.get('attachment'):
284:             f = log['attachment']
285:             lines += ['', '- 原件：' + t(f['name']) + ('（完整内容在 JSON 中）' if f['included'] else '（本包未携带原件）'), t(f['preview'])]
286:     lines += ['', '## 接手反馈与进展', '']
287:     for e in record['events']:
288:         lines.append('- ' + t(e['at']) + ' · ' + t(e['actor']) + ' · ' + t(e['kind']) + '：' + t(e['note']) + ' · 依据：' + t(e.get('evidence', '')))
289:     if record.get('importedHistory'):
290:         lines += ['', '导入前的历史保存在 JSON，尚未在本机核实。']
291:     lines += ['', '## 项目版本与完整证据', '', render_markdown(record['handoff'])]
292:     return '\n'.join(lines)
