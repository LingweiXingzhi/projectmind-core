9:     action = data.get('action', 'list')
10:     if method == 'GET':
11:         if action == 'list':
12:             return {'entries': store.listing(), 'categories': CATEGORIES,
13:                     'note': '记录保存在本机项目，尚未独立核实；关键决策分类不代表团队已批准。'}
14:         if action == 'get':
15:             return {'entry': store.get(data.get('id'))}
16:         if action == 'history':
17:             return {'history': store.history(data.get('id'))}
18:         if action == 'file':
19:             return {'file': store.file(data.get('id'))}
20:         if action == 'backup':
21:             return store.backup()
22:     if method == 'POST':
23:         if action == 'save':
24:             return {'entry': store.save(data, context.snapshot()['revision'])}
25:         if action == 'import_start':
26:             return store.start(data)
27:         if action == 'import_chunk':
28:             return store.chunk(data)
29:         if action == 'import_finish':
30:             return {'entry': store.finish(data, context.snapshot()['revision'])}
31:         if action == 'import_cancel':
32:             return store.cancel(data.get('uploadId'))
33:     fail('不支持的日志操作')

