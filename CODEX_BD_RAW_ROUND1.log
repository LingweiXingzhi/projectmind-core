72:                 handle = getattr(module, "handle", None)
73:                 if not isinstance(metadata, dict) or any(
74:                     not isinstance(metadata.get(key), str) or not metadata[key].strip()
75:                     for key in ("title", "description")
76:                 ) or not callable(handle):
77:                     raise ValueError("需要 EXTENSION.title/description 和 handle(context, method, data)")
78:                 page = folder / "index.html"
79:                 self.loaded[identifier] = _LoadedExtension(
80:                     metadata["title"], metadata["description"], handle,
81:                     page if page.is_file() and not page.is_symlink() else None,
82:                 )
83:             except (Exception, SystemExit) as exc:
84:                 self.unavailable[identifier] = f"加载失败：{type(exc).__name__}"
85: 
86:     def listing(self) -> dict:
87:         entries = [
88:             {"id": identifier, "title": extension.title, "description": extension.description,
89:              "status": "ready", "pageUrl": f"/ext/{identifier}",
90:              "apiUrl": f"/api/extensions/{identifier}"}
91:             for identifier, extension in self.loaded.items()
92:         ]
93:         entries.extend(
94:             {"id": identifier, "status": "unavailable", "note": reason}
95:             for identifier, reason in self.unavailable.items()
96:         )
97:         return {"extensions": sorted(entries, key=lambda entry: entry["id"])}
98: 
99:     def get(self, identifier: str) -> _LoadedExtension:
100:         if identifier in self.unavailable:
101:             raise ExtensionError(HTTPStatus.SERVICE_UNAVAILABLE, self.unavailable[identifier])
102:         if identifier not in self.loaded:
103:             raise ExtensionError(HTTPStatus.NOT_FOUND, "扩展不存在")
104:         return self.loaded[identifier]
105: 
106:     def page(self, identifier: str, generic_page: Path) -> bytes:
107:         extension = self.get(identifier)
108:         return (extension.page or generic_page).read_bytes()
109: 
110:     def run(self, identifier: str, method: str, data: dict) -> dict:
111:         extension = self.get(identifier)
112:         try:
113:             result = extension.handle(self.context, method, data)
114:         except ExtensionError:
115:             raise
116:         except Exception as exc:
117:             raise ExtensionError(HTTPStatus.INTERNAL_SERVER_ERROR, "扩展运行失败") from exc
118:         if not isinstance(result, dict):
119:             raise ExtensionError(HTTPStatus.INTERNAL_SERVER_ERROR, "扩展必须返回 JSON 对象")
120:         try:
121:             json.dumps(result, ensure_ascii=False, allow_nan=False).encode("utf-8")
122:         except (TypeError, ValueError, UnicodeError) as exc:
123:             raise ExtensionError(HTTPStatus.INTERNAL_SERVER_ERROR, "扩展结果无法编码为 JSON") from exc
124:         return result

