311: def read_evidence(repo: Path, map_path: Path, path: str, revision: str) -> dict:
312:     curated = load_map(map_path)
313:     allowed = {item["path"] for node in curated["nodes"] for item in node["evidence"]}
314:     if path not in allowed:
315:         raise ValueError("Evidence path is not declared in this map")
316:     commit = commit_id(repo, revision)
317:     if path not in files_at_commit(repo, commit):
318:         raise FileNotFoundError(f"{path} is absent at this commit")
319:     content = git(repo, "show", f"{commit}:{path}").decode("utf-8", errors="replace")
320:     return {
321:         "path": path,
322:         "revision": commit,
323:         "content": content[:12000],
324:         "truncated": len(content) > 12000,
325:     }
