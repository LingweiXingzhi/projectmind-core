21: def canonical_remote(value):
22:     # Address equality is a clue, not authenticated repository identity.
23:     if not isinstance(value, str) or not value.strip():
24:         return None
25:     value = value.strip()
26:     match = re.fullmatch(r'(?:[^/@:]+@)?([^/:]+):([^\s]+)', value)
27:     if match and '://' not in value and not value.startswith(('/', '.', '~')):
28:         host, name = match.groups()
29:     else:
30:         try:
31:             parsed = urlsplit(value)
32:             port = parsed.port
33:         except ValueError:
34:             return None
35:         if parsed.scheme not in ('http', 'https', 'ssh', 'git') or not parsed.hostname:
36:             return None
37:         if parsed.username not in (None, 'git') or parsed.password or parsed.query or parsed.fragment:
38:             return None
39:         host, name = parsed.hostname, parsed.path
40:         if port:
41:             host += ':' + str(port)
42:     name = name.strip('/')
43:     if name.endswith('.git'):
44:         name = name[:-4]
45:     if not name or '..' in name.split('/'):
46:         return None
47:     return host.lower() + '/' + name
