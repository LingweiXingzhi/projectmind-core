469:     server = ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(repo, map_path))
470:     print(f"ProjectMind demo: http://127.0.0.1:{server.server_port}", flush=True)
471:     try:
472:         server.serve_forever()
473:     except KeyboardInterrupt:
474:         pass
475:     finally:
