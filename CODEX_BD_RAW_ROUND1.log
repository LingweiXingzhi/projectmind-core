11: def main_revision(context):
12:     """Resolve the locally fetched remote tracking ref, without network access."""
13:     try:
14:         result = subprocess.run(['git', '-C', str(context.repo), 'rev-parse', '--verify',
15:                                  'refs/remotes/origin/main^{commit}'], capture_output=True,
16:                                 text=True, timeout=5)
17:     except (OSError, subprocess.TimeoutExpired) as exc:
18:         raise HandoffError('无法读取本机 origin/main，请检查 Git 仓库') from exc
19:     revision = result.stdout.strip()
20:     if result.returncode or not SHA.fullmatch(revision):
21:         raise HandoffError('本机没有 origin/main，请在 GitHub Desktop 执行 Fetch origin 后重试')
22:     return revision
