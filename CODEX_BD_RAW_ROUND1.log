109: def build_snapshot(repo: Path, map_path: Path, revision: str = "HEAD") -> dict:
110:     commit = commit_id(repo, revision)
111:     tracked = files_at_commit(repo, commit)
112:     try:
113:         parent = git(repo, "rev-parse", "--verify", f"{commit}^").decode().strip()
114:     except GitError:
115:         parent = None
116:     curated = load_map(map_path)
117:     nodes = []
118:     for node in curated["nodes"]:
119:         evidence = [
120:             {**item, "existsAtCommit": item["path"] in tracked}
121:             for item in node["evidence"]
122:         ]
123:         nodes.append({**node, "evidence": evidence})
124:     try:
125:         branch = git(repo, "symbolic-ref", "--short", "HEAD").decode().strip()
126:     except GitError:
127:         branch = "detached HEAD"
128:     return {
129:         "repository": repo.name,
130:         "revision": commit,
131:         "parentRevision": parent,
132:         "branch": branch,
133:         "mapOrigin": "curated_demo",
134:         "mapNote": curated["note"],
135:         "nodes": nodes,
136:         "edges": curated["edges"],
137:     }
