97: def resolve_sources(repo_path: Path | None, map_path: Path | None) -> tuple[Path, Path]:
98:     candidate = (repo_path or ROOT).expanduser().resolve()
99:     if not candidate.is_dir():
100:         raise ValueError(f"Repository directory does not exist: {candidate}")
101:     root = Path(git(candidate, "rev-parse", "--show-toplevel").decode("utf-8", errors="replace").strip()).resolve()
102:     if root != ROOT and map_path is None:
103:         raise ValueError("A different repository requires --map with a curated map JSON file")
104:     selected_map = (map_path or MAP_PATH).expanduser().resolve()
105:     load_map(selected_map)
106:     return root, selected_map
