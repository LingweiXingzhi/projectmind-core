50: def commit_id(repo: Path, ref: str = "HEAD") -> str:
51:     if ref != "HEAD" and not SHA_PATTERN.fullmatch(ref):
52:         raise ValueError("Commit must be a full Git SHA")
53:     return git(repo, "rev-parse", "--verify", f"{ref}^{{commit}}").decode().strip()
