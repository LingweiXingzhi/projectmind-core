128:   <script>
129:     'use strict';
130:     const el = id => document.getElementById(id);
131:     const kinds = { function: '函数', async_function: '异步函数', class: '类', method: '方法', async_method: '异步方法' };
132:     let facts = null;
133:     let selectedPath = null;
134:     let sequence = 0;
135:     let controller = null;
136:     let busy = false;
137:     let revisionEdited = false;
138: 
139:     function setStatus(message, state = '') {
140:       el('status').textContent = message;
141:       el('status').className = 'state' + (state ? ' ' + state : '');
142:       el('status').hidden = false;
143:     }
144: 
145:     function clearResults() {
146:       facts = null;
147:       selectedPath = null;
148:       el('result').hidden = true;
149:       el('result-sha').textContent = '';
150:       el('download').disabled = true;
151:       el('file-list').replaceChildren();
152:       el('entry-body').replaceChildren();
153:       el('skip-list').replaceChildren();
154:       el('search').value = '';
155:     }
156: 
157:     function setBusy(value) {
158:       busy = value;
159:       el('extract').disabled = value;
160:       el('extract').textContent = value ? '正在提取…' : '提取代码事实';
161:       el('query-form').setAttribute('aria-busy', String(value));
162:     }
163: 
164:     function validFacts(value, requestedRevision) {
165:       if (!value || typeof value !== 'object' || typeof value.revision !== 'string' || value.revision !== requestedRevision || !Array.isArray(value.files) || !Array.isArray(value.skipped)) return false;
166:       const filesOK = value.files.every(file => file && typeof file.path === 'string' && file.language === 'python' && Array.isArray(file.entries) && file.entries.every(entry => entry && typeof entry.name === 'string' && Object.hasOwn(kinds, entry.kind) && Number.isInteger(entry.line) && entry.line > 0));
167:       const skipsOK = value.skipped.every(item => item && typeof item.path === 'string' && typeof item.reason === 'string');
168:       return filesOK && skipsOK;
169:     }
170: 
171:     const visiblePath = path => /^ | $/.test(path) ? JSON.stringify(path) : path;
172: 
173:     function filteredFiles() {
174:       const query = el('search').value.trim().toLocaleLowerCase();
175:       return facts.files.filter(file => !query || file.path.toLocaleLowerCase().includes(query) || file.entries.some(entry => entry.name.toLocaleLowerCase().includes(query)));
176:     }
177: 
178:     function renderFiles() {
179:       const visible = filteredFiles();
180:       if (!visible.some(file => file.path === selectedPath)) selectedPath = visible.length ? visible[0].path : null;
181:       const items = visible.map(file => {
182:         const li = document.createElement('li');
183:         const button = document.createElement('button');
184:         button.type = 'button';
185:         button.className = 'file-button';
186:         button.setAttribute('aria-pressed', String(file.path === selectedPath));
187:         const path = document.createElement('span');
188:         path.className = 'file-path';
189:         path.textContent = visiblePath(file.path);
190:         const meta = document.createElement('span');
191:         meta.className = 'file-meta';
192:         meta.textContent = 'Python · ' + file.entries.length + ' 个定义';
193:         button.append(path, meta);
194:         button.addEventListener('click', () => { selectedPath = file.path; renderFiles(); });
195:         li.append(button);
196:         return li;
197:       });
198:       el('file-list').replaceChildren(...items);
199:       el('no-files').hidden = visible.length !== 0;
200:       renderEntries();
201:     }
202: 
203:     function renderEntries() {
204:       const file = facts.files.find(item => item.path === selectedPath);
205:       el('selected-path').textContent = file ? visiblePath(file.path) : '定义详情';
206:       const query = el('search').value.trim().toLocaleLowerCase();
207:       const entries = file ? file.entries.filter(entry => !query || file.path.toLocaleLowerCase().includes(query) || entry.name.toLocaleLowerCase().includes(query)) : [];
208:       const rows = entries.map(entry => {
209:         const row = document.createElement('tr');
210:         const name = document.createElement('td');
211:         name.textContent = entry.name;
212:         const type = document.createElement('td');
213:         const badge = document.createElement('span');
214:         badge.className = 'kind';
215:         badge.textContent = kinds[entry.kind];
216:         type.append(badge);
217:         const line = document.createElement('td');
218:         line.textContent = String(entry.line);
219:         row.append(name, type, line);
220:         return row;
221:       });
222:       el('entry-body').replaceChildren(...rows);
223:       el('entry-table').hidden = rows.length === 0;
224:       el('no-entries').hidden = rows.length !== 0;
225:       el('no-entries').textContent = file ? '该文件中没有符合条件的函数、类或方法。' : '选择一个文件查看代码定义。';
226:     }
227: 
228:     function showResults(value) {
229:       facts = value;
230:       const firstWithDefinitions = value.files.find(file => file.entries.length > 0);
231:       selectedPath = firstWithDefinitions ? firstWithDefinitions.path : null;
232:       el('result-sha').textContent = value.revision;
233:       el('file-count').textContent = String(value.files.length);
234:       el('entry-count').textContent = String(value.files.reduce((total, file) => total + file.entries.length, 0));
235:       el('skip-count').textContent = String(value.skipped.length);
236:       el('skip-title').textContent = '跳过的文件（' + value.skipped.length + '）';
237:       el('skip-details').hidden = value.skipped.length === 0;
238:       const items = value.skipped.map(item => {
239:         const li = document.createElement('li');
240:         const path = document.createElement('span');
241:         path.className = 'skip-path';
242:         path.textContent = visiblePath(item.path);
243:         const reason = document.createElement('span');
244:         reason.className = 'skip-reason';
245:         reason.textContent = item.reason;
246:         li.append(path, reason);
247:         return li;
248:       });
249:       el('skip-list').replaceChildren(...items);
250:       el('result').hidden = false;
251:       el('download').disabled = false;
252:       setStatus(value.files.length ? '提取完成。行号对应上方结果版本，可交给 C 核查和分析。' : '提取完成，但没有可展示的 Python 文件。请查看跳过原因或调整路径。');
253:       renderFiles();
254:     }
255: 
256:     el('query-form').addEventListener('submit', async event => {
257:       event.preventDefault();
258:       const requestedRevision = el('revision').value.trim();
259:       const queryID = ++sequence;
260:       if (controller) controller.abort();
261:       clearResults();
262:       if (!/^([0-9a-f]{40}|[0-9a-f]{64})$/.test(requestedRevision)) {
263:         setStatus('请输入完整的 40 或 64 位小写提交 SHA。', 'error');
264:         el('revision').focus();
265:         return;
266:       }
267:       const paths = el('paths').value.split(/\r?\n/).filter(path => path.length > 0);
268:       const payload = { revision: requestedRevision };
269:       if (paths.length) payload.paths = paths;
270:       controller = new AbortController();
271:       setBusy(true);
272:       setStatus('正在读取指定提交并解析代码…', 'loading');
273:       try {
274:         const response = await fetch('/api/extensions/code_facts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), signal: controller.signal });
275:         let value;
276:         try { value = await response.json(); } catch { throw new Error('服务返回了无法读取的 JSON。'); }
277:         if (queryID !== sequence) return;
278:         if (!response.ok) throw new Error(value && typeof value.error === 'string' ? value.error : '提取失败（HTTP ' + response.status + '）。');
279:         if (!validFacts(value, requestedRevision)) throw new Error('响应的版本或数据格式与本次请求不一致，请检查接口。');
280:         showResults(value);
281:       } catch (error) {
282:         if (queryID !== sequence || error.name === 'AbortError') return;
283:         clearResults();
284:         setStatus(error instanceof TypeError ? '无法连接本地服务，请确认服务正在运行后重试。' : error.message, 'error');
285:       } finally {
286:         if (queryID === sequence) setBusy(false);
287:       }
288:     });
289: 
290:     function invalidateQuery() {
291:       if (controller && busy) {
292:         ++sequence;
293:         controller.abort();
294:         setBusy(false);
295:       }
296:       if (facts || el('status').classList.contains('loading')) {
297:         clearResults();
298:         setStatus('输入已更改，请重新提取代码事实。');
299:       }
300:     }
301: 
302:     el('revision').addEventListener('input', () => { revisionEdited = true; invalidateQuery(); });
303:     el('paths').addEventListener('input', invalidateQuery);
304:     el('search').addEventListener('input', () => { if (facts) renderFiles(); });
305:     el('download').addEventListener('click', () => {
306:       if (!facts) return;
307:       const blob = new Blob([JSON.stringify(facts, null, 2) + '\n'], { type: 'application/json;charset=utf-8' });
308:       const url = URL.createObjectURL(blob);
309:       const link = document.createElement('a');
310:       link.href = url;
311:       link.download = 'code-facts-' + facts.revision + '.json';
312:       document.body.append(link);
313:       link.click();
314:       link.remove();
315:       setTimeout(() => URL.revokeObjectURL(url), 1000);
316:     });
317: 
318:     async function loadSnapshot() {
319:       try {
320:         const response = await fetch('/api/snapshot');
321:         if (!response.ok) throw new Error('snapshot');
322:         const snapshot = await response.json();
323:         el('repository').textContent = typeof snapshot.repository === 'string' ? snapshot.repository : '由本地服务指定';
324:         if (!revisionEdited && typeof snapshot.revision === 'string' && /^([0-9a-f]{40}|[0-9a-f]{64})$/.test(snapshot.revision)) el('revision').value = snapshot.revision;
325:       } catch {
326:         el('repository').textContent = '快照未读取，请确认本地服务正在运行。';
327:       }
328:     }
329:     loadSnapshot();
330:   </script>
331: </body>
