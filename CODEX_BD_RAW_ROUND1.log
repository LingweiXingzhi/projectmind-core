99: def render_markdown(handoff):
100:     """Human-readable projection; the JSON download remains the full record."""
101:     t = _text
102:     source = handoff['sourceLocator']
103:     nodes = {n['id']: n for n in handoff['nodes']}
104:     lines = ['# ProjectMind 交接摘要', '', '状态：未确认交接草稿。功能与关系来自人工地图，AI 内容仅为候选。', '',
105:              '## 版本与来源', '',
106:              '- 项目：' + t(handoff['repository']),
107:              '- 仓库来源：' + ('Git 仓库地址' if source['kind'] == 'git_remote' else '本地路径') + ' · ' + t(source['value']),
108:              '- 代码提交：`' + handoff['codeRevision'] + '`',
109:              '- 地图核查状态：**UNKNOWN（尚未确认适用版本）**',
110:              '- 地图来源类型：' + t(handoff['mapOrigin'])]
111:     if 'baseRevision' in handoff:
112:         lines.append('- 比较基准：`' + handoff['baseRevision'] + '`')
113:     if handoff.get('comparisonSource'):
114:         lines.append('- 基准来源：' + t(handoff['comparisonSource']))
115:     if handoff.get('mapNote'):
116:         lines.append('- 地图备注：' + t(handoff['mapNote']))
117:     lines += ['', '## 本次变化', '']
118:     if 'baseRevision' not in handoff:
119:         lines.append('未提供提交比较，不能据此判断代码是否变化。')
120:     elif not handoff['changes']:
121:         lines.append('这两个提交之间没有文件变化。')
122:     else:
123:         lines += ['共 ' + str(len(handoff['changes'])) + ' 个变化文件。', '', '| 变化 | 文件 |', '| --- | --- |']
124:         names = {'A': '新增', 'M': '修改', 'D': '删除', 'R': '重命名', 'C': '复制', 'T': '类型变化'}
125:         for change in handoff['changes']:
126:             code = change['code']
127:             label = names.get(code[:1], code)
128:             path = t(change['path'])
129:             if change.get('oldPath'):
130:                 path = t(change['oldPath']) + ' → ' + path
131:             lines.append('| ' + t(label) + ' | ' + path + ' |')
132:     lines += ['', '## 优先复核', '']
133:     if handoff['reviewCandidates']:
134:         for item in handoff['reviewCandidates']:
135:             node = nodes[item['nodeId']]
136:             lines.append('- ' + t(node['title']) + '（' + t(item['nodeId']) + '）：' + '、'.join(t(p) for p in item['changedEvidencePaths']))
137:     elif 'baseRevision' in handoff:
138:         lines.append('没有变化路径匹配到当前地图声明的节点证据。这不证明没有功能影响；新增文件可能尚未登记在地图中。')
139:     else:
140:         lines.append('未进行比较，尚未生成待复核节点。')
141:     if handoff.get('comparisonNote'):
142:         lines += ['', t(handoff['comparisonNote'])]
143:     if handoff.get('unmappedChanges'):
144:         lines += ['', '## 地图未覆盖的变化', '',
145:                   '以下文件的新旧路径均未匹配当前地图声明的证据。逐项检查其职责与调用方，再决定是否需要补充地图；这不是架构影响结论。', '']
146:         for change in handoff['unmappedChanges']:
147:             path = t(change['path'])
148:             if change.get('oldPath'):
149:                 path = t(change['oldPath']) + ' → ' + path
150:             lines.append('- ' + t(change['code']) + ' · ' + path)
151:     lines += ['', '## 功能与核查入口', '', '| 功能（节点 ID） | 职责说明 | 关键入口 | 证据路径及状态 |', '| --- | --- | --- | --- |']
152:     for node in handoff['nodes']:
153:         evidence = []
154:         for item in node['evidence']:
155:             state = '此提交存在' if item.get('existsAtCommit') else '缺失或未核查'
156:             evidence.append(t(item['path']) + '（' + state + '；' + t(item.get('reason', '')) + '）')
157:         lines.append('| ' + t(node['title']) + '（' + t(node['id']) + '） | ' + t(node['summary']) + ' | ' + t(node['entryPoint']) + ' | ' + '；'.join(evidence) + ' |')
158:     lines += ['', '## 人工地图中的关系', '']
159:     if not handoff['edges']:
160:         lines.append('地图未提供关系。')
161:     for edge in handoff['edges']:
162:         source_title = nodes.get(edge['from'], {}).get('title', edge['from'])
163:         target_title = nodes.get(edge['to'], {}).get('title', edge['to'])
164:         lines.append('- ' + t(source_title) + '（' + t(edge['from']) + '） → ' + t(target_title) + '（' + t(edge['to']) + '）：' + t(edge['label']))
165:     lines += ['', '## AI 候选解释', '']
166:     if not handoff['aiCandidates']:
167:         lines.append('未提供 AI 解释结果。')
168:     for candidate in handoff['aiCandidates']:
169:         explanation = candidate['explanation']
170:         lines += ['### ' + t(nodes[candidate['nodeId']]['title']), '',
171:                   '- 性质：ai_candidate，未确认。',
172:                   '- 模型：' + t(candidate.get('model', 'UNKNOWN')),
173:                   '- 比较版本：`' + candidate['baseRevision'] + '` → `' + candidate['targetRevision'] + '`',
174:                   '- 差异截断：' + ('是' if candidate.get('diffTruncated') else '否'),
175:                   '- 变化证据：' + '、'.join(t(p) for p in candidate['changedEvidencePaths']),
176:                   '- 引用证据：' + '、'.join(t(p) for p in explanation['evidencePaths']),
177:                   '- 摘要：' + t(explanation.get('summary', ''))]
178:         for key, label in [('observations', '观察'), ('possibleEffects', '可能影响'), ('unknowns', '未知项')]:
179:             lines += ['', '**' + label + '**', '']
180:             values = explanation.get(key, [])
181:             lines.extend('- ' + t(value) for value in values)
182:             if not values:
183:                 lines.append('无已提供内容。')
184:         if candidate.get('note'):
185:             lines += ['', '候选备注：' + t(candidate['note'])]
186:     lines += ['', '## 尚未确认', '']
187:     lines.extend('- ' + t(value) for value in handoff['unknowns'])
188:     if handoff.get('workNotes'):
189:         lines += ['', '## 工作备注', '', '性质：协作者填写的工作记录，尚未独立核实。', '']
190:         for key, label in [('completed', '已完成'), ('pending', '待办'), ('blockers', '阻塞'), ('nextSteps', '下一步')]:
191:             lines.append('- ' + label + '：' + t(handoff['workNotes'].get(key, '').strip() or '未填写'))
192:     lines += ['', '## 下一步：接手步骤', '',
193:               '1. 按仓库来源取得项目，检出上方完整代码提交。',
194:               '2. 若有比较基准，对照该基准与代码提交检查变化文件。',
195:               '3. 按优先复核项与功能表中的证据路径核查；没有节点匹配时，直接检查变化文件及地图覆盖范围。',
196:               '4. 向团队确认地图适用版本；保留 AI 候选与未知项，核查后再作决定。', '',
197:               '核查提示：' + t(handoff['nextCheck']), '',
198:               '完整结构化记录请同时下载 JSON；本摘要不包含源码或 Git 差异正文。', '']
199:     return '\n'.join(lines)
