11: def git(repo, *args):
12:     try:
13:         r = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, timeout=10)
14:     except (OSError, subprocess.TimeoutExpired):
15:         fail('Git 读取失败或超时，请检查本机仓库')
16:     if r.returncode:
17:         fail('当前仓库无法读取所需 Git 资料')
18:     return r.stdout
