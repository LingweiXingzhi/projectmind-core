{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectMind architecture-loop audit verdict",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_id": {
      "type": "string"
    },
    "target_sha": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "CHANGES_REQUESTED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "summary",
          "evidence"
        ]
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "target_sha",
    "scope",
    "verdict",
    "findings",
    "unverified",
    "notes"
  ]
}