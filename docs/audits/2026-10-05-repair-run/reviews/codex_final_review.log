+def run_engine(base_files, target_files, map_data, changed, facts=None,
+               base_entries=None):
+    repo, base, target, tmp = build_repo(base_files, target_files)
+    if facts is None:
+        facts = facts_for(target, sorted(
+            {p for p in base_files} | {p for p in target_files}))
+    request = {
