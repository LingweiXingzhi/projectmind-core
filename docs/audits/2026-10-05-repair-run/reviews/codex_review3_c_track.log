state={}
BASE='1'*40; TARGET='2'*40
class Cleanup:
    def cleanup(self): pass
def memory_repo(base_files,target_files):
    base={p:v for p,v in base_files.items() if v is not None}
    target=dict(base)
    for p,v in target_files.items():
        if v is None: target.pop(p,None)
        else: target[p]=v
    state.clear(); state.update({BASE:base,TARGET:target})
    return Path('memory-repo'),BASE,TARGET,Cleanup()
def blob(repo,revision,path):
    try: return state[revision][path]
    except KeyError: raise gitio.DiffSignalError('missing memory blob')
def tree(repo,revision):
    if revision not in state: raise gitio.DiffSignalError('unknown memory revision')
    return set(state[revision])

