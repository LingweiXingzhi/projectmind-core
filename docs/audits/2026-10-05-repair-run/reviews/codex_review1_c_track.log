+    B skip reason when available."""
+    violations = []
+    for path in sorted(set(paths)):
+        state = path_eligibility(path, facts)
+        if state == "eligible":
+            continue
+        violations.append(
+            (path, state, facts.get("skipped_reasons", {}).get(path)))
+    return (not violations, violations)
