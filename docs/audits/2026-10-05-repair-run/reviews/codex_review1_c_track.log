                {
                    "subject": event["path"],
                    "reason": "HUMAN_REQUIRED",
                    "evidence": [diff_evidence(target, event["path"],
                                               f"dynamic import: {tag}")],
                    "note": "��̬/�ַ������� import�������źŲ��㣬�����Խ�����ϵ��ѡ",
                }
