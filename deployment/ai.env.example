# Copy outside the web/source tree and fill privately on your server.
# Blank values are intentional. Never commit the populated copy.
PROJECTMIND_AI_SHARED_FROM_ENV=1
# Set 1 to remove application token ceilings and use the provider's output default.
# Usage is still recorded. This applies only to server-managed shared API.
PROJECTMIND_AI_UNLIMITED=0
# Whole model request wait (queue/network/retry together), not a token quota.
# Explicit short connection probes keep their own timeout. Proxy wait must be longer.
PROJECTMIND_AI_TIMEOUT_SECONDS=180
# Demo policy for DeepSeek V4: request low reasoning; other/legacy models unchanged.
# Use high/max for deeper reasoning or none to explicitly disable thinking.
PROJECTMIND_AI_REASONING_EFFORT=low
PROJECTMIND_AI_API_KEY=
PROJECTMIND_AI_BASE_URL=https://maas.qianwenapi.com/compatible-mode/v1
PROJECTMIND_AI_MODEL=
PROJECTMIND_AI_PROTOCOL=chat_completions
