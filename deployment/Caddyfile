# Caddy 2.11.7 or a later verified version. Domain must match publicOrigin.
{$PROJECTMIND_DOMAIN} {
	encode gzip
	request_body {
		max_size 1MB
	}
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:8765 {
		# Keep original Host and Origin. Never manufacture a local origin.
		header_up -Forwarded
		header_up -X-Forwarded-User
		header_up -X-ProjectMind-Actor
		header_up -X-ProjectMind-Session
	}
}
