[Unit]
Description=ProjectMind dedicated Caddy HTTPS proxy
After=network-online.target projectmind.service
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --config /etc/caddy/projectmind.Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/projectmind.Caddyfile --adapter caddyfile
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/caddy
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy

[Install]
WantedBy=multi-user.target
